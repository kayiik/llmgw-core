# First member fails before output; the second member serves
request: POST /v1/chat/completions
status: 200
header Cache-Control: no-cache
header Connection: keep-alive
header Content-Type: text/event-stream
header X-Llmgw-Prompt-Bytes: 39
header X-Llmgw-Tool-Schema-Bytes: 0
header X-Llmgw-Ttfb-Ms: <ms>
upstream: POST /a/chat/completions
upstream body: {"messages":[{"content":"Say hello","role":"user"}],"model":"model-a","stream":true}
upstream: POST /b/chat/completions
upstream body: {"messages":[{"content":"Say hello","role":"user"}],"model":"model-b","stream":true}
body:
data: {"choices":[{"delta":{"content":"Hello","role":"assistant"},"finish_reason":null,"index":0}],"created":"<time>","id":"chatcmpl_fixture","model":"model-b","object":"chat.completion.chunk"}

data: {"choices":[{"delta":{"content":" from chat"},"finish_reason":null,"index":0}],"created":"<time>","id":"chatcmpl_fixture","model":"model-b","object":"chat.completion.chunk"}

data: {"choices":[{"delta":{},"finish_reason":"stop","index":0}],"created":"<time>","id":"chatcmpl_fixture","model":"model-b","object":"chat.completion.chunk","usage":{"completion_tokens":4,"prompt_tokens":3,"total_tokens":7}}

data: [DONE]
