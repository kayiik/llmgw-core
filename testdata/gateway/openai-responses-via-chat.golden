# Responses translated to a Chat-only model
request: POST /v1/responses
status: 200
header Content-Type: application/json
header X-Llmgw-Transport-Mode: translated
upstream: POST /f/chat/completions
upstream body: {"messages":[{"content":"Say hello","role":"user"}],"model":"chat-model","stream":false}
body:
{
  "background": false,
  "created_at": "<time>",
  "error": null,
  "id": "chatcmpl_fixture",
  "incomplete_details": null,
  "instructions": null,
  "max_output_tokens": null,
  "max_tool_calls": null,
  "metadata": {},
  "model": "chat-model",
  "object": "response",
  "output": [
    {
      "content": [
        {
          "annotations": [],
          "text": "Hello from chat",
          "type": "output_text"
        }
      ],
      "id": "msg_chatcmpl_fixture",
      "role": "assistant",
      "status": "completed",
      "type": "message"
    }
  ],
  "output_text": "Hello from chat",
  "parallel_tool_calls": true,
  "previous_response_id": null,
  "reasoning": {
    "effort": null,
    "summary": null
  },
  "service_tier": "default",
  "status": "completed",
  "store": false,
  "temperature": null,
  "text": {
    "format": {
      "type": "text"
    }
  },
  "tool_choice": "auto",
  "tools": [],
  "top_logprobs": 0,
  "top_p": null,
  "truncation": "disabled",
  "usage": {
    "input_tokens": 3,
    "input_tokens_details": {
      "cached_tokens": 0
    },
    "output_tokens": 4,
    "output_tokens_details": {
      "reasoning_tokens": 0
    },
    "total_tokens": 7
  },
  "user": null
}
